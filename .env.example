# ─────────────────────────────────────────────────────────────
# Online Store — environment variables
# Copy this file to `.env.local` for local dev, and set the same
# keys in the Vercel dashboard for production.
# NEVER commit `.env.local` or `.env` to git — already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Supabase — project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — anon (public) key. Safe to expose to the browser.
# Used by the client and server to read public catalog data.
# (Project Settings → API → Project API keys → `anon` `public`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service_role key. SERVER-SIDE ONLY.
# ⚠️  NEVER COMMIT THIS. NEVER EXPOSE TO THE BROWSER.
# ⚠️  This key can ONLY do data-plane operations (SELECT/INSERT/
#     UPDATE/DELETE on existing tables, call existing RPCs).
#     It CANNOT run DDL like CREATE TABLE / ALTER TABLE. Schema
#     changes must be pasted into the Supabase SQL Editor.
# (Project Settings → API → Project API keys → `service_role`)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — secret key. SERVER-SIDE ONLY.
# Test mode key starts with `sk_test_`. Live mode key starts with
# `sk_live_`. Use test keys while verifying the flow.
# (Stripe Dashboard → Developers → API keys → Secret key)
STRIPE_SECRET_KEY=

# Stripe — webhook signing secret. SERVER-SIDE ONLY.
# Get from `stripe listen --forward-to localhost:3000/api/stripe-webhook`
# during local dev, or from the Stripe Dashboard → Webhooks → endpoint
# details after adding the production endpoint. Starts with `whsec_`.
STRIPE_WEBHOOK_SECRET=

# Stripe — publishable key. Safe to expose to the browser.
# Test mode key starts with `pk_test_`. Live mode key starts with
# `pk_live_`. Use test keys while verifying the flow.
# (Stripe Dashboard → Developers → API keys → Publishable key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public URL of the deployed site. Used to build absolute URLs
# (Stripe redirects, email links, etc.).
#   Local dev:  http://localhost:3000
#   Production: https://<your-project>.vercel.app
# Set this AFTER the first Vercel deploy once you know the real URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
